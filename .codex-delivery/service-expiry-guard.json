{
  "schemaVersion": 1,
  "guardVersion": "1",
  "publicStatusPath": "/api/public/service-status/",
  "defaults": {
    "serviceExpiryDate": null,
    "enforcementEnabled": false
  },
  "failOpenScenarios": [
    "query_failed",
    "timeout",
    "missing_expiry",
    "enforcement_disabled",
    "guard_version_unregistered"
  ],
  "excludedPaths": [
    "/admin",
    "/admin/login",
    "/api",
    "/_next",
    "/favicon.ico",
    "static-assets"
  ],
  "guardFiles": ["lib/service-expiry-guard.ts"],
  "integrationFiles": ["lib/service-expiry-integration.ts"],
  "expiredPageFiles": ["app/service-expired/page.tsx"],
  "backendRegistration": {
    "registered": true,
    "guardVersion": "1",
    "evidencePath": ".codex-delivery/evidence/service-guard-normal.md"
  },
  "productionVerification": {
    "normal": {"result": "PASS", "evidencePath": ".codex-delivery/evidence/service-guard-normal.md"},
    "simulatedExpired": {"result": "PASS", "evidencePath": ".codex-delivery/evidence/service-guard-expired.md"},
    "renewalRecovery": {"result": "PASS", "evidencePath": ".codex-delivery/evidence/service-guard-renewal.md"},
    "adminReachable": {"result": "PASS", "evidencePath": ".codex-delivery/evidence/service-guard-admin.md"}
  }
}
